# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/smart_auditorium
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/smart_auditorium

# JWT Secret — generate a strong random string (min 32 chars)
# You can generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App URL (your Vercel URL after deployment)
NEXTAUTH_URL=http://localhost:3000
